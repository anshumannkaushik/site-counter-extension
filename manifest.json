{
  "manifest_version": 3,
  "name": "Site Counter - All Tabs",
  "version": "1.4",
  "description": "Counts the mapped site rows (BOOKING, BOOKING APP, XP, etc.) on every open hotel search tab and gives a total across all tabs.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://live.ql2.com/*",
    "http://live.ql2.com/*"
  ],
  "icons": {
    "128": "icon.png",
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Site Counter - All Tabs"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://live.ql2.com/*",
        "http://live.ql2.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "site-counter@anshuman.local"
    }
  }
}
